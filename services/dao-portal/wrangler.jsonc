{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mythical-dao-portal",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
  },
  "triggers": {
    "crons": ["* * * * *"],
  },
  "vars": {
    "ENVIRONMENT": "local",
    "DEPLOYMENT_MANIFEST": "",
    "INDEX_BATCH_BLOCKS": "1000",
    "INDEX_SOURCES_PER_RUN": "6",
    "INDEX_RPC_MODE": "standard",
    "INDEX_RPC_PRIMARY_URL": "",
    "INFURA_DAILY_CREDITS": "2400000",
    "GRAPH_COMPARE_MODE": "off",
    "GRAPH_SUBGRAPH_RESTRICTED": "false",
    "GRAPH_ALLOW_UNRESTRICTED_SERVER_KEY": "false",
    "GRAPH_READ_MODE": "off",
    "GRAPH_REORG_VERIFIED": "false",
  },
  "secrets": {
    "required": ["RPC_PRIMARY_URL", "RPC_SECONDARY_URL"],
  },
  "d1_databases": [
    {
      "binding": "DAO_DB",
      "database_name": "mythical-dao-portal-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "env": {
    "staging": {
      "name": "mythical-dao-portal-staging",
      // Infura Free + Tenderly passed the historical preflight on 2026-09-29.
      // Quota, cooldown and cursors persist in D1. Wallet reads stay independent.
      "triggers": { "crons": ["* * * * *"] },
      "secrets": {
        "required": ["RPC_PRIMARY_URL", "RPC_SECONDARY_URL", "INFURA_API_KEY"],
      },
      "vars": {
        "ENVIRONMENT": "staging",
        "DEPLOYMENT_MANIFEST": "",
        "INDEX_BATCH_BLOCKS": "5000",
        "INDEX_SOURCES_PER_RUN": "1",
        "INDEX_RPC_MODE": "infura-free",
        "INDEX_RPC_PRIMARY_URL": "",
        "INFURA_DAILY_CREDITS": "2400000",
        // User accepted server-only query-key scope exception on 2026-10-01.
        // Provider restriction remains absent; fixed destination and quotas apply.
        "GRAPH_COMPARE_MODE": "shadow",
        "GRAPH_SUBGRAPH_RESTRICTED": "false",
        "GRAPH_ALLOW_UNRESTRICTED_SERVER_KEY": "true",
        "GRAPH_READ_MODE": "verified",
        "GRAPH_REORG_VERIFIED": "true",
        "INDEX_RPC_SECONDARY_URL": "https://tenderly.rpc.polygon.community",
        "PORTAL_ORIGIN": "https://dao-preview.mythicalbeings.io",
      },
      "d1_databases": [
        {
          "binding": "DAO_DB",
          "database_name": "mythical-dao-portal-staging",
          "database_id": "21fdc00b-6e28-4b64-ab73-5a1117c7d463",
          "migrations_dir": "migrations",
        },
      ],
    },
    "production": {
      "name": "mythical-dao-portal-production",
      "vars": {
        "ENVIRONMENT": "production",
        "DEPLOYMENT_MANIFEST": "",
        "INDEX_BATCH_BLOCKS": "1000",
        "INDEX_SOURCES_PER_RUN": "1",
        "INDEX_RPC_MODE": "standard",
        "INDEX_RPC_PRIMARY_URL": "",
        "INFURA_DAILY_CREDITS": "2400000",
        "GRAPH_COMPARE_MODE": "off",
        "GRAPH_SUBGRAPH_RESTRICTED": "false",
        "GRAPH_ALLOW_UNRESTRICTED_SERVER_KEY": "false",
        "GRAPH_READ_MODE": "off",
        "GRAPH_REORG_VERIFIED": "false",
      },
      "d1_databases": [
        {
          "binding": "DAO_DB",
          "database_name": "mythical-dao-portal-production",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
